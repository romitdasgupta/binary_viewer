# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Temporary build files in fixtures
fixtures/*.c
fixtures/*.m
fixtures/*.cpp
fixtures/*.slice

# Local CLI state
.antigravitycli/

# Static (in-browser) build output and an optional in-repo Pyodide cache (tools/build_static.py).
